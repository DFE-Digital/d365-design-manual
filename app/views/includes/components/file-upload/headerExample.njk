<div class="govuk-form-group">
  <h1 class="govuk-label-wrapper">
    <label class="govuk-label govuk-label--l" for="schema-name">
      Upload your evidence
    </label>
  </h1>
  <div id="schema-name-hint" class="govuk-hint">
    The file must be a PDF or Word document, and smaller than 3MB
  </div>
  <div class="govuk-file-upload-wrapper" data-module="govuk-file-upload">
    <input class="govuk-file-upload" id="schema-name" name="schema-name" type="file" aria-describedby="schema-name-hint">
  </div>
</div>