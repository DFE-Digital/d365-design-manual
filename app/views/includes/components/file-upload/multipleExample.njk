<div class="govuk-form-group">
  <label class="govuk-label" for="schema-name">
    Upload your files
  </label>
  <div id="schema-name-hint" class="govuk-hint">
    You can upload up to 3 files
  </div>
  <div class="govuk-file-upload-wrapper" data-module="govuk-file-upload">
    <input class="govuk-file-upload" id="schema-name" name="schema-name" type="file" multiple aria-describedby="schema-name-hint">
  </div>
</div>